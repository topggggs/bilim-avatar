# npm run dev works with these local, synthetic defaults. Never use demo mode for real employees.
NODE_ENV=development
AUTH_MODE=demo
PORT=3001
APP_ORIGIN=http://localhost:5173
STORAGE_MODE=file
DATA_DIR=.data
AVATAR_PROVIDER=fallback
# Production: AUTH_MODE=oidc, STORAGE_MODE=postgres, AVATAR_PROVIDER=openai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://bilim:change-me@localhost:5432/bilim
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
VISION_MODEL=gpt-4.1-mini
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bilim-avatars
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional learning portal origins; relative module paths are allowlisted server-side.
BILIM_BASE_URL=
BUILDEX_BASE_URL=
BIU_BASE_URL=
S3_SSE=

# Email/password accounts are separate from corporate OIDC: AUTH_MODE=local.
# Local production requires HTTPS, PostgreSQL, SESSION_SECRET and the SMTP fields below.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated exact corporate domains; mandatory in local production.
REGISTRATION_DOMAINS=
# Phone registration becomes available in local mode when all three Twilio fields are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_ALLOWED_PREFIXES=+7
# Demo shows synthetic email links and SMS codes. Production never returns them.
